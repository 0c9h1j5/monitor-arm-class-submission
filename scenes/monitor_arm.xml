<mujoco model="monitor_arm_v1">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast"/>

  <visual>
    <global offwidth="1600" offheight="1000" fovy="45"/>
    <headlight diffuse="0.72 0.72 0.72" ambient="0.34 0.34 0.34" specular="0.15 0.15 0.15"/>
    <rgba haze="0.93 0.95 0.97 1"/>
  </visual>

  <asset>
    <texture name="tex_sky" type="skybox" builtin="gradient" width="512" height="512"
             rgb1="0.93 0.95 0.98" rgb2="0.82 0.86 0.91"/>
    <texture name="tex_floor" type="2d" builtin="checker" width="512" height="512"
             rgb1="0.86 0.87 0.89" rgb2="0.78 0.80 0.83"/>
    <material name="mat_floor" texture="tex_floor" texrepeat="6 6" reflectance="0.08"/>
    <material name="mat_wood" rgba="0.73 0.57 0.41 1" specular="0.1" shininess="0.2"/>
    <material name="mat_metal" rgba="0.25 0.27 0.31 1" specular="0.4" shininess="0.5"/>
    <material name="mat_arm" rgba="0.17 0.19 0.23 1" specular="0.35" shininess="0.4"/>
    <material name="mat_screen" rgba="0.11 0.16 0.24 1" specular="0.25" shininess="0.6"/>
    <material name="mat_wall" rgba="0.90 0.91 0.93 1" specular="0.05"/>
    <material name="mat_chair" rgba="0.22 0.24 0.28 1" specular="0.1"/>
    <material name="mat_skin" rgba="0.87 0.75 0.65 1" specular="0.05"/>
    <material name="mat_shirt" rgba="0.28 0.42 0.56 1" specular="0.05"/>
    <material name="mat_pants" rgba="0.24 0.28 0.35 1" specular="0.05"/>
    <material name="mat_shoe" rgba="0.16 0.16 0.18 1" specular="0.1"/>
  </asset>

  <worldbody>
    <light pos="0.8 -1.5 2.5" dir="-0.2 0.5 -0.8" diffuse="0.75 0.75 0.75" castshadow="true"/>
    <light pos="-1.2 -0.6 2.0" dir="0.5 0.2 -0.8" diffuse="0.35 0.35 0.35" castshadow="false"/>

    <!-- 바닥 (z = 0) -->
    <geom name="floor" type="plane" size="2.8 2.8 0.05" material="mat_floor"/>

    <!-- 뒷벽 (책상 뒷면 y = 0.35 m 기준 8 cm 뒤, 앞면 y = 0.43 m) -->
    <body name="wall" pos="0 0.44 1.0">
      <geom name="wall_geom" type="box" size="1.20 0.01 1.00" material="mat_wall"/>
      <site name="wall_front" pos="0 -0.01 0" size="0.008" rgba="0.6 0.6 0.6 0.5"/>
    </body>

    <!-- 일반 사무 책상 (1.20 x 0.70 x 0.72 m, 상판 윗면 z = 0.72 m) -->
    <body name="desk" pos="0 0 0">
      <geom name="desk_top" type="box" pos="0 0 0.705" size="0.60 0.35 0.015" material="mat_wood"/>
      <geom name="desk_leg_fl" type="box" pos="-0.55 -0.30 0.345" size="0.02 0.02 0.345" material="mat_metal"/>
      <geom name="desk_leg_fr" type="box" pos="0.55 -0.30 0.345" size="0.02 0.02 0.345" material="mat_metal"/>
      <geom name="desk_leg_bl" type="box" pos="-0.55 0.30 0.345" size="0.02 0.02 0.345" material="mat_metal"/>
      <geom name="desk_leg_br" type="box" pos="0.55 0.30 0.345" size="0.02 0.02 0.345" material="mat_metal"/>
      <site name="desk_surface" pos="0 0 0.72" size="0.008" rgba="0.5 0.5 0.5 0.6"/>
    </body>

    <!-- 모니터암 고정 기둥 (책상 뒤쪽 중앙 클램프 y = 0.34 m, 높이 0.90 m -> z = 0.72 ~ 1.62 m) -->
    <body name="arm_base" pos="0 0.34 0.72">
      <geom name="arm_clamp" type="box" pos="0 0 0.015" size="0.05 0.035 0.015"
            contype="0" conaffinity="0" material="mat_arm"/>
      <geom name="arm_pole" type="cylinder" pos="0 0 0.45" size="0.022 0.45"
            contype="0" conaffinity="0" material="mat_metal"/>

      <!-- 1축: 높이 조절 캐리지 (arm_lift, q = 0일 때 z = 0.90 m, 스트로크 0.55 m -> z = 0.90 ~ 1.45 m) -->
      <body name="arm_carriage" pos="0 0 0.18" gravcomp="1">
        <joint name="arm_lift" type="slide" axis="0 0 1" range="0.0 0.55" damping="18"/>
        <geom name="arm_collar" type="cylinder" pos="0 0 0" size="0.034 0.04"
              contype="0" conaffinity="0" mass="1.2" material="mat_arm"/>
        <site name="collar_anchor" pos="0 -0.02 0" size="0.005" rgba="0.2 0.2 0.2 0"/>

        <!-- 2축: 앞뒤 거리 슬라이더 (arm_reach, q = 0일 때 y = 0.14 m, 범위 -0.38 ~ +0.15 m) -->
        <body name="arm_slider" pos="0 -0.20 0" gravcomp="1">
          <joint name="arm_reach" type="slide" axis="0 1 0" range="-0.38 0.15" damping="15"/>
          <geom name="arm_slider_block" type="box" pos="0 0.015 0" size="0.024 0.018 0.024"
                contype="0" conaffinity="0" mass="0.5" material="mat_metal"/>
          <site name="slider_anchor" pos="0 0.015 0" size="0.005" rgba="0.2 0.2 0.2 0"/>

          <!-- 3축: 좌우 회전 (arm_yaw, ±30도) -->
          <body name="monitor_yaw_body" pos="0 0 0" gravcomp="1">
            <joint name="arm_yaw" type="hinge" axis="0 0 1" range="-0.52 0.52" damping="2.0"/>
            <geom name="arm_wrist_hub" type="cylinder" pos="0 0 0" size="0.022 0.022"
                  contype="0" conaffinity="0" mass="0.2" material="mat_arm"/>

            <!-- 4축: 위아래 기울기 (arm_tilt, ±26도) + 27인치 모니터 (0.61 x 0.03 x 0.36 m, 4.5 kg) -->
            <body name="monitor_mount" pos="0 0 0" gravcomp="1">
              <joint name="arm_tilt" type="hinge" axis="1 0 0" range="-0.45 0.45" damping="2.5"/>
              <geom name="vesa_plate" type="box" pos="0 -0.005 0" size="0.055 0.008 0.055"
                    contype="0" conaffinity="0" mass="0.3" material="mat_metal"/>
              <geom name="monitor_panel" type="box" pos="0 -0.025 0" size="0.305 0.015 0.18"
                    mass="4.5" material="mat_arm"/>
              <geom name="monitor_screen" type="box" pos="0 -0.0405 0" size="0.293 0.001 0.168"
                    contype="0" conaffinity="0" mass="0.0" material="mat_screen"/>
              <site name="monitor_center" pos="0 -0.042 0" size="0.009" rgba="0.95 0.85 0.15 1"/>
              <site name="monitor_top" pos="0 -0.042 0.18" size="0.012" rgba="0.12 0.78 0.36 1"/>
              <site name="monitor_bottom" pos="0 -0.042 -0.18" size="0.010" rgba="0.95 0.55 0.12 1"/>
              <site name="monitor_back" pos="0 -0.010 0" size="0.008" rgba="0.6 0.6 0.6 0.6"/>

              <!-- 모니터 상단 웹캠 (광각 세로 시야 75도 가정, 사용자 쪽 -y 방향) -->
              <body name="webcam_unit" pos="0 -0.025 0.195" gravcomp="1">
                <geom name="webcam_body" type="box" pos="0 0 0" size="0.04 0.015 0.015"
                      contype="0" conaffinity="0" mass="0.1" material="mat_metal"/>
                <geom name="webcam_lens_geom" type="cylinder" pos="0 -0.016 0" euler="1.5708 0 0"
                      size="0.008 0.004" contype="0" conaffinity="0" mass="0.0" rgba="0.08 0.22 0.38 1"/>
                <camera name="webcam" pos="0 -0.022 0" xyaxes="-1 0 0 0 0 1" fovy="75"/>
                <site name="webcam_lens" pos="0 -0.021 0" size="0.006" rgba="0.20 0.62 0.98 1"/>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>

    <!-- 사용자 머리 (mocap #0: 충돌 활성, 눈 위치 표시) -->
    <body name="user_head" mocap="true" pos="0 -0.58 1.20">
      <geom name="head_geom" type="ellipsoid" pos="0 0 0" size="0.085 0.095 0.11" material="mat_skin"/>
      <geom name="eye_left" type="sphere" pos="-0.032 0.088 0" size="0.012"
            contype="0" conaffinity="0" rgba="0.10 0.12 0.18 1"/>
      <geom name="eye_right" type="sphere" pos="0.032 0.088 0" size="0.012"
            contype="0" conaffinity="0" rgba="0.10 0.12 0.18 1"/>
      <geom name="nose_geom" type="capsule" pos="0 0.095 -0.022" size="0.008 0.012"
            contype="0" conaffinity="0" material="mat_skin"/>
      <site name="eye_center" pos="0 0.094 0" size="0.012" rgba="0.92 0.20 0.20 1"/>
      <geom name="neck_geom" type="cylinder" pos="0 0 -0.145" size="0.044 0.06"
            contype="0" conaffinity="0" material="mat_skin"/>
    </body>

    <!-- 사용자 상체 (mocap #1: 골반 기준 회전, 충돌 활성) -->
    <body name="user_torso" mocap="true" pos="0 -0.58 0.54">
      <geom name="hip_geom" type="box" pos="0 0 0.02" size="0.16 0.09 0.06"
            contype="0" conaffinity="0" material="mat_pants"/>
      <geom name="torso_geom" type="box" pos="0 0 0.28" size="0.17 0.09 0.22" material="mat_shirt"/>
      <geom name="arm_left_geom" type="capsule" fromto="-0.20 0.0 0.44 -0.20 0.06 0.16" size="0.042"
            contype="0" conaffinity="0" material="mat_shirt"/>
      <geom name="arm_right_geom" type="capsule" fromto="0.20 0.0 0.44 0.20 0.06 0.16" size="0.042"
            contype="0" conaffinity="0" material="mat_shirt"/>
    </body>

    <!-- 사용자 허벅지 (mocap #2: 골반 기준) -->
    <body name="user_thighs" mocap="true" pos="0 -0.58 0.50" quat="0.7071 0.7071 0 0">
      <geom name="thigh_left" type="capsule" fromto="-0.095 0 0 -0.095 0 -0.41" size="0.058"
            contype="0" conaffinity="0" material="mat_pants"/>
      <geom name="thigh_right" type="capsule" fromto="0.095 0 0 0.095 0 -0.41" size="0.058"
            contype="0" conaffinity="0" material="mat_pants"/>
    </body>

    <!-- 사용자 정강이·발 (mocap #3: 무릎 기준, 발바닥이 바닥 z = 0에 닿음) -->
    <body name="user_shins" mocap="true" pos="0 -0.17 0.49">
      <geom name="shin_left" type="capsule" fromto="-0.095 0 0 -0.095 0 -0.43" size="0.046"
            contype="0" conaffinity="0" material="mat_pants"/>
      <geom name="shin_right" type="capsule" fromto="0.095 0 0 0.095 0 -0.43" size="0.046"
            contype="0" conaffinity="0" material="mat_pants"/>
      <geom name="shoe_left" type="box" pos="-0.095 0.05 -0.46" size="0.048 0.105 0.03"
            contype="0" conaffinity="0" material="mat_shoe"/>
      <geom name="shoe_right" type="box" pos="0.095 0.05 -0.46" size="0.048 0.105 0.03"
            contype="0" conaffinity="0" material="mat_shoe"/>
    </body>

    <!-- 사무용 의자 하부·좌판 (mocap #4) -->
    <body name="office_chair" mocap="true" pos="0 -0.58 0">
      <geom name="chair_base" type="cylinder" pos="0 0 0.035" size="0.24 0.025"
            contype="0" conaffinity="0" material="mat_metal"/>
      <geom name="chair_stem" type="cylinder" pos="0 0 0.23" size="0.025 0.19"
            contype="0" conaffinity="0" material="mat_metal"/>
      <geom name="chair_seat" type="box" pos="0 0.02 0.435" size="0.23 0.22 0.025"
            contype="0" conaffinity="0" material="mat_chair"/>
    </body>

    <!-- 사무용 의자 등받이 (mocap #5: 기대 눕기 자세에서 함께 뒤로 기울어짐) -->
    <body name="chair_backrest" mocap="true" pos="0 -0.78 0.45">
      <geom name="chair_back" type="box" pos="0 0 0.27" size="0.22 0.024 0.26"
            contype="0" conaffinity="0" material="mat_chair"/>
    </body>
  </worldbody>

  <!-- 신축식 수평 암 연결봉 표현 (기둥 캐리지 <-> 슬라이더) -->
  <tendon>
    <spatial name="arm_boom_visual" width="0.018" rgba="0.20 0.22 0.26 1">
      <site site="collar_anchor"/>
      <site site="slider_anchor"/>
    </spatial>
  </tendon>

  <actuator>
    <position name="act_lift" joint="arm_lift" kp="1800" kv="150" ctrlrange="0.0 0.55" forcerange="-80 80"/>
    <position name="act_reach" joint="arm_reach" kp="1500" kv="120" ctrlrange="-0.38 0.15" forcerange="-80 80"/>
    <position name="act_yaw" joint="arm_yaw" kp="80" kv="12" ctrlrange="-0.52 0.52" forcerange="-20 20"/>
    <position name="act_tilt" joint="arm_tilt" kp="80" kv="12" ctrlrange="-0.45 0.45" forcerange="-20 20"/>
  </actuator>

  <sensor>
    <jointpos name="arm_lift_pos" joint="arm_lift"/>
    <jointvel name="arm_lift_vel" joint="arm_lift"/>
    <actuatorfrc name="arm_lift_force" actuator="act_lift"/>
    <jointpos name="arm_reach_pos" joint="arm_reach"/>
    <jointvel name="arm_reach_vel" joint="arm_reach"/>
    <actuatorfrc name="arm_reach_force" actuator="act_reach"/>
    <jointpos name="arm_yaw_pos" joint="arm_yaw"/>
    <jointvel name="arm_yaw_vel" joint="arm_yaw"/>
    <jointpos name="arm_tilt_pos" joint="arm_tilt"/>
    <jointvel name="arm_tilt_vel" joint="arm_tilt"/>
    <framepos name="monitor_center_pos" objtype="site" objname="monitor_center"/>
    <framepos name="monitor_top_pos" objtype="site" objname="monitor_top"/>
    <framepos name="eye_center_pos" objtype="site" objname="eye_center"/>
  </sensor>

  <keyframe>
    <!-- 1. 똑바로 앉기 (eye_z=1.20 m, y_screen=0.11 m, tilt=-11.5도) -->
    <key name="seated"
         qpos="0.115 0.01 0.0 -0.20"
         ctrl="0.115 0.01 0.0 -0.20"
         mpos="0 -0.58 1.20  0 -0.58 0.54  0 -0.58 0.50  0 -0.17 0.49  0 -0.58 0.00  0 -0.78 0.45"
         mquat="1 0 0 0  1 0 0 0  0.7071 0.7071 0 0  1 0 0 0  1 0 0 0  1 0 0 0"/>

    <!-- 2. 앞으로 숙이기 (몸 앞으로 18도, 화면 뒤로 물러남 y_screen=0.25 m, 거리 유지) -->
    <key name="lean_forward"
         qpos="0.067 0.15 0.0 -0.22"
         ctrl="0.067 0.15 0.0 -0.22"
         mpos="0 -0.376 1.168  0 -0.58 0.54  0 -0.58 0.50  0 -0.17 0.49  0 -0.58 0.00  0 -0.78 0.45"
         mquat="0.9962 -0.0872 0 0  0.9877 -0.1564 0 0  0.7071 0.7071 0 0  1 0 0 0  1 0 0 0  1 0 0 0"/>

    <!-- 3. 의자에 기대 눕기 (등받이 36도, 화면 앞으로 다가오고 내려오며 아래로 +5도 기울임) -->
    <key name="reclined"
         qpos="0.062 -0.30 0.0 0.09"
         ctrl="0.062 -0.30 0.0 0.09"
         mpos="0 -0.84 0.975  0 -0.47 0.46  0 -0.47 0.46  0 -0.06 0.49  0 -0.54 0.00  0 -0.62 0.45"
         mquat="0.9925 0.1219 0 0  0.9455 0.3256 0 0  0.7071 0.7071 0 0  0.9945 0.1045 0 0  1 0 0 0  0.9455 0.3256 0 0"/>

    <!-- 4. 서기 (발바닥 z=0 접지, eye_z=1.56 m, 화면 상승, 의자는 옆으로 치움) -->
    <key name="standing"
         qpos="0.475 -0.01 0.0 -0.20"
         ctrl="0.475 -0.01 0.0 -0.20"
         mpos="0 -0.60 1.56  0 -0.60 0.90  0 -0.60 0.90  0 -0.60 0.49  -0.68 -0.86 0.00  -0.82 -1.00 0.45"
         mquat="1 0 0 0  1 0 0 0  1 0 0 0  1 0 0 0  0.9239 0 0 -0.3827  0.9239 0 0 -0.3827"/>
  </keyframe>
</mujoco>
